 function linkOrDisabled(label, href, className = 'button button--ghost contact-link') {
   if (!href) {
     return `<span class="${className}" aria-disabled="true">${label}</span>`;
   }
   const external = href.startsWith('http');
   return `<a class="${className}" href="${href}"${external ? ' target="_blank" rel="noreferrer"' : ''}>${label}</a>`;
 }

-export function renderPage(lang) {
+const TECH_ICON_IDS = Object.freeze({
+  Go: 'go',
+  PostgreSQL: 'postgresql',
+  Docker: 'docker',
+  Git: 'git',
+  Kafka: 'kafka',
+  gRPC: 'grpc',
+  Redis: 'redis',
+  'REST API': 'rest-api',
+  Grafana: 'grafana',
+});
+
+function renderTechChip(name, techIconsPath) {
+  const iconId = TECH_ICON_IDS[name];
+  if (!iconId) return `<span class="chip"><span class="chip__label">${name}</span></span>`;
+
+  return `
+    <span class="chip">
+      <svg class="chip__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+        <use href="${techIconsPath}#tech-${iconId}"></use>
+      </svg>
+      <span class="chip__label">${name}</span>
+    </span>`;
+}
+
+export function renderPage(lang, { techIconsPath = '/tech-icons.svg' } = {}) {
   const c = siteContent[lang];
   if (!c) throw new Error(`Unsupported language: ${lang}`);
@@
