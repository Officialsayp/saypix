{
	servers {
		protocols h1 h2
	}
}

import site.caddy

http://origin.maxzolotoy.com {
	redir https://origin.maxzolotoy.com{uri} 308
}

https://origin.maxzolotoy.com {
	import maxzolotoy_static
	header X-Robots-Tag "noindex, nofollow"
}

http://maxzolotoy.com, http://www.maxzolotoy.com {
	redir https://maxzolotoy.com{uri} 308
}

https://www.maxzolotoy.com {
	redir https://maxzolotoy.com{uri} 308
}

https://maxzolotoy.com {
	import maxzolotoy_static
}